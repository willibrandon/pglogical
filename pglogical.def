; pglogical Windows DLL exports
; Functions exported for PostgreSQL extension loading
EXPORTS
    ; Module initialization (required for shared_preload_libraries)
    _PG_init
    _PG_output_plugin_init

    ; Module magic
    Pg_magic_func

    ; Node management
    pglogical_create_node
    pglogical_drop_node
    pglogical_alter_node_add_interface
    pglogical_alter_node_drop_interface
    pglogical_node_info

    ; Subscription management
    pglogical_create_subscription
    pglogical_drop_subscription
    pglogical_alter_subscription_interface
    pglogical_alter_subscription_disable
    pglogical_alter_subscription_enable
    pglogical_alter_subscription_add_replication_set
    pglogical_alter_subscription_remove_replication_set
    pglogical_alter_subscription_resynchronize_table
    pglogical_alter_subscription_synchronize
    pglogical_show_subscription_status
    pglogical_show_subscription_table
    pglogical_wait_for_subscription_sync_complete
    pglogical_wait_for_table_sync_complete

    ; Replication set management
    pglogical_create_replication_set
    pglogical_drop_replication_set
    pglogical_alter_replication_set
    pglogical_replication_set_add_table
    pglogical_replication_set_add_all_tables
    pglogical_replication_set_remove_table
    pglogical_replication_set_add_sequence
    pglogical_replication_set_add_all_sequences
    pglogical_replication_set_remove_sequence
    pglogical_show_repset_table_info
    pglogical_show_repset_table_info_by_target

    ; DDL replication
    pglogical_replicate_ddl_command
    pglogical_queue_truncate

    ; Utility functions
    pglogical_version
    pglogical_version_num
    pglogical_max_proto_version
    pglogical_min_proto_version
    pglogical_gen_slot_name
    pglogical_wait_slot_confirm_lsn
    pglogical_synchronize_sequence
    pglogical_table_data_filtered
    pglogical_xact_commit_timestamp_origin

    ; Triggers and hooks
    pglogical_truncate_trigger_add
    pglogical_dependency_check_trigger
    pglogical_hooks_setup
